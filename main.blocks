<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="S#o0E@?u_:JAU*:nUyNb" x="0" y="0"><statement name="HANDLER"><block type="game_show_long_text" id="!L+NQi9E34pRc)Z9hj$N"><field name="layout">DialogLayout.Center</field><value name="str"><shadow type="text" id="]**LH_Jib*lfqueY~TZ."><field name="TEXT">Welcome back folks! Today we have the...</field></shadow></value><next><block type="game_show_long_text" id="e/6AX*Llj%Hs]7g_XsB4"><field name="layout">DialogLayout.Center</field><value name="str"><shadow type="text" id="XpB#zcR.syW`G)9}1Erp"><field name="TEXT">Chicago Bears v.s Green Bay Packers!</field></shadow></value><next><block type="game_show_long_text" id="o}z%uv6BM{w0@2dKXr*:"><field name="layout">DialogLayout.Center</field><value name="str"><shadow type="text" id="gz}s*FK/*[/;AdKzwwyI"><field name="TEXT">Let's get this game started after a quick tip on the next page</field></shadow></value><next><block type="game_show_long_text" id=";$^n29@H*r9=TH=gzS`Z"><field name="layout">DialogLayout.Center</field><value name="str"><shadow type="text" id="=ps+6kO#c?hqV)MsUFTE"><field name="TEXT">Click "edit" on the bottom of the game to change difficulty, teams, and jerseys!</field></shadow></value><next><block type="game_show_long_text" id="C6}#^?[AE)KI+-yIsa+["><field name="layout">DialogLayout.Center</field><value name="str"><shadow type="text" id="7$|x|u9EFLg)!iEq6ci@"><field name="TEXT">This is NFL arcade brought to you by Gabe Joseph</field></shadow></value><next><block type="createGame" id="*1sTe:/$^ZS:,vYeShjv"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><field name="playerTeam">league.chicagoBears</field><field name="aiTeam">league.greenBayPackers</field><comment pinned="false" h="80" w="160">You will need to change the dialogue above depending on what teams you choose</comment><value name="quarterLength"><shadow type="math_number" id="TA4Od)[tZ$Sul8Vc^AXH"><fi